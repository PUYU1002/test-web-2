                      gap: '0',
                      zIndex: 10,
                    }}
                  >
                    {/* 国内外观众按钮 */}
                    <button
                      onClick={() => setViewMode('国内外观众')}
                      style={{
                        background: 'none',
                        border: 'none',
                        cursor: 'pointer',
                        padding: 0,
