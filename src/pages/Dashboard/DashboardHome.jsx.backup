                    >
                      <img
                        src={`/assets/images/${
                          viewMode === '各大洲观众'
                            ? '各大洲观众-高亮.png'
                            : '各大洲观众-未选中.png'
                        }`}
                        alt="各大洲观众"
                        style={{
                          height: 'clamp(0.6rem, 1vh, 0.8rem)',
                          width: 'auto',
                        }}
                      />
                    </button>
                  </div>

                  {/* 背景图片区域 */}
                  <div
                    onClick={() => navigate('/movie/6')}
                    style={{
                      width: '100%',
                      height: '100%',
                      backgroundImage: `url(/assets/images/${viewMode}分别喜欢什么样的${
                        activeCategory === '门派'
                          ? '江湖门派'
                          : activeCategory === '精神'
                          ? '侠义精神'
                          : '武林功夫'
                      }.png)`,
                      backgroundSize: 'contain',
                      backgroundRepeat: 'no-repeat',
                      backgroundPosition: 'center',
                      cursor: 'pointer',
                      transition: 'all 0.3s ease',
                    }}
                    onMouseEnter={(e) => {
                      e.target.style.transform = 'scale(1.02)'
                    }}
                    onMouseLeave={(e) => {
                      e.target.style.transform = 'scale(1)'
                    }}
                  ></div>
                </div>
              </RightMiddlePanel>
            </MiddleArea>

            {/* 底部图表面板 - 显示第三段数据(50%) */}
            <BottomChartPanel style={{ position: 'relative' }}>
              {segmentedData?.segment3?.data?.length > 0 && (
                <div style={{
                  position: 'absolute',
                  top: '10%',
                  left: '2%',
                  width: '96%',
                  height: '80%',
                  overflow: 'hidden',
                  display: 'flex',
                  flexDirection: 'row',
                  gap: '12px',
                  alignItems: 'center',
                  justifyContent: 'space-between',
                  padding: '20px'
                }}>
                  {segmentedData.segment3.data.map((item, index) => (
                    <div key={index} style={{ 
                      position: 'relative',
                      display: 'flex',
                      flexDirection: 'column',
                      alignItems: 'center',
                      height: '100%',
                      flex: '1'
                    }}>
                      {/* 竖直虚线 - 贴近文字 */}
                      <div style={{
                        position: 'absolute',
                        top: '15%',
                        bottom: '20%',
                        left: '50%',
                        transform: 'translateX(-50%)',
                        width: '1px',
                        background: 'linear-gradient(to bottom, transparent 0%, #896053 15%, #896053 85%, transparent 100%)',
                        borderLeft: '1px dashed #896053',
                        zIndex: 1
                      }}></div>
                      
                      {/* 数据点 - 空心圆圈 */}
                      <div style={{ 
                        width: '16px',
                        height: '16px',
                        background: 'transparent',
                        border: '2px solid #E1D7D4',
                        borderRadius: '50%',
                        cursor: 'pointer',
                        boxShadow: '0 0 8px rgba(225, 215, 212, 0.7)',
                        transition: 'all 0.3s ease',
                        position: 'relative',
                        zIndex: 2,
                        marginTop: '60px'
                      }}
                      onMouseEnter={(e) => {
                        e.target.style.transform = 'scale(1.3)';
                        e.target.style.boxShadow = '0 0 12px rgba(225, 215, 212, 1)';
                        if (item && handleDataPointHover) {
                          handleDataPointHover(item, index); // 根据数据映射背景
                        }
                      }}
                      onMouseLeave={(e) => {
                        e.target.style.transform = 'scale(1)';
                        e.target.style.boxShadow = '0 0 8px rgba(225, 215, 212, 0.7)';
                      }}
                      ></div>
                      
                      {/* 电影信息文字 - 时间在上，名称在下，固定宽度 */}
                      <div style={{
                        position: 'absolute',
                        bottom: '2px',
                        left: '50%',
                        transform: 'translateX(-50%)',
                        fontSize: '9px',
                        color: '#534C4C',
                        textAlign: 'center',
                        fontWeight: 'bold',
                        zIndex: 3,
                        pointerEvents: 'none',
                        width: '50px'
                      }}>
                        <div style={{ fontSize: '8px', opacity: 0.8, marginBottom: '2px' }}>
                          {item?.['上映年份'] || item?.['年份'] || '未知'}
                        </div>
                        <div style={{ 
                          lineHeight: '1.1',
                          wordWrap: 'break-word',
                          overflowWrap: 'break-word',
                          hyphens: 'auto'
                        }}>
                          {item?.['电影名'] || item?.['电影'] || `数据项${index + 1}`}
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              )}
            </BottomChartPanel>
          </ContentContainer>
        </MainContent>
      </DashboardContainer>
    </>
  )
}

export default DashboardHome
