                            alignItems: 'center',
                            height: '100%',
                            flex: '1'
                          }}>
                            {/* 竖直虚线 - 贴近文字 */}
                            <div style={{
                              position: 'absolute',
                              top: '10%',
                              bottom: '20%',
                              left: '50%',
                              transform: 'translateX(-50%)',
