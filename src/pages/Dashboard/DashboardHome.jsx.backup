                }}
              >
                {/* 门派按钮 */}
                <div
                  onClick={() => handleCategoryChange('门派')}
                  onMouseEnter={(e) => {
                    if (activeCategory !== '门派') {
                      e.currentTarget.style.backgroundImage =
                        'url(/assets/images/buttons/门派悬浮或点击选中.png)'
