                    height: 'clamp(1.2rem, 2vw, 1.8rem)',
                    backgroundImage:
                      activeCategory === '武功'
                        ? 'url(/assets/images/buttons/武功悬浮或点击选中.png)'
                        : 'url(/assets/images/buttons/武功未选中.png)',
                    backgroundSize: 'contain',
                    backgroundRepeat: 'no-repeat',
                    backgroundPosition: 'center',
