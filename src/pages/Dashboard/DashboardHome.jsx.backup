const DashboardHome = () => {
  const navigate = useNavigate()
  
  // 数据状态
  const [excelData, setExcelData] = useState([])
  const [segmentedData, setSegmentedData] = useState({
    segment1: { data: [], count: 0, percentage: 0 },
    segment2: { data: [], count: 0, percentage: 0 },
    segment3: { data: [], count: 0, percentage: 0 }
  })
  
  // 控制状态
  const [activeCategory, setActiveCategory] = useState('门派')
  const [viewMode, setViewMode] = useState('国内外观众')
  const [segment1Percentage, setSegment1Percentage] = useState(0.3)
  const [segment2Percentage, setSegment2Percentage] = useState(0.35)
  const [segment3Percentage, setSegment3Percentage] = useState(0.35)
  
  // 背景状态
  const [currentBackground, setCurrentBackground] = useState('/assets/images/backgrounds/1.png')
  const [imagesLoaded, setImagesLoaded] = useState(false)
  
  // 加载状态
  const [dataLoading, setDataLoading] = useState(true)
  const [dataError, setDataError] = useState(null)

  // 初始化背景图片对象
  const initBackgroundImages = () => {
    console.log('🖼️ 开始使用 require 加载本地背景图片...')
    
    try {
      // 使用 require 加载所有背景图片
      for (let i = 1; i <= 48; i++) {
        try {
          if (i === 16) {
            // 16.png不存在，使用15.png作为替代
            backgroundImages[i] = require(`../../assets/images/backgrounds/15.png`)
            console.log(`✅ 已加载背景图片: ${i}.png (使用15.png替代)`)
          } else {
            backgroundImages[i] = require(`../../assets/images/backgrounds/${i}.png`)
            console.log(`✅ 已加载背景图片: ${i}.png`)
          }
        } catch (error) {
          console.log(`❌ 加载失败的图片: ${i}.png，使用默认图片`)
          // 使用默认图片作为备用
          backgroundImages[i] = require(`../../assets/images/backgrounds/1.png`)
        }
      }
      
      console.log('🎉 所有背景图片加载完成!')
      console.log('📊 已加载图片数量:', Object.keys(backgroundImages).length)
      console.log('🔑 已加载的图片索引:', Object.keys(backgroundImages).sort((a, b) => parseInt(a) - parseInt(b)).join(', '))
      
      // 设置默认背景图片
      if (backgroundImages[1]) {
        setCurrentBackground(backgroundImages[1])
        console.log('🎨 设置默认背景图片: 1.png')
      }
      
      setImagesLoaded(true)
      
    } catch (error) {
      console.error('❌ 背景图片加载失败:', error)
      // 设置默认图片
      backgroundImages[1] = '/assets/images/backgrounds/1.png'
      setCurrentBackground('/assets/images/backgrounds/1.png')
      setImagesLoaded(true)
    }
  }

  // 初始化电影名称映射表
  const initMovieNameMapping = () => {
    console.log('🎬 开始初始化电影名称映射表...')
    
    const movieList = [
      '倩女幽魂', '英雄本色', '黄飞鸿', '笑傲江湖', '东方不败',
      '新龙门客栈', '青蛇', '白发魔女传', '刀', '射雕英雄传之东成西就',
      '太极张三丰', '黄飞鸿之二：男儿当自强', '方世玉', '黄飞鸿之三：狮王争霸', '醉拳二',
      '黄河大侠', '火烧圆明园', '垂帘听政', '少林寺', '少林小子',
      '南北少林', '木棉袈裟', '武当', '少林三十六房', '十八般武艺',
      '陆阿采与黄飞鸿', '黄飞鸿', '黄飞鸿之铁鸡斗蜈蚣', '黄飞鸿之男儿当自强', '黄飞鸿之狮王争霸',
      '黄飞鸿之西域雄狮', '黄飞鸿之龙城歼霸', '黄飞鸿92之龙行天下', '黄飞鸿之铁马骝', '黄飞鸿之鬼脚七',
      '黄飞鸿之五大弟子', '黄飞鸿之八大天王', '黄飞鸿之怒海雄风', '黄飞鸿之南北英雄', '黄飞鸿之龙城歼霸',
      '少林寺传奇', '少林武王', '少林英雄', '少林门', '少林与武当',
      '少林三十六房', '少林搭棚大师', '六指琴魔'
    ]
    
    console.log('📋 电影列表长度:', movieList.length)
    
    // 清空原有映射表
    Object.keys(movieNameToImageMap).forEach(key => delete movieNameToImageMap[key])
    
    movieList.forEach((movieName, index) => {
      const imageIndex = index + 1
      try {
        if (imageIndex === 16) {
          // 16.png不存在，使用15.png作为替代
          movieNameToImageMap[movieName] = require(`../../assets/images/backgrounds/15.png`)
          console.log(`✅ 映射成功: "${movieName}" → ${imageIndex}.png (使用15.png替代)`)
        } else {
          movieNameToImageMap[movieName] = require(`../../assets/images/backgrounds/${imageIndex}.png`)
          console.log(`✅ 映射成功: "${movieName}" → ${imageIndex}.png`)
        }
      } catch (error) {
        console.log(`❌ 映射失败: "${movieName}" → ${imageIndex}.png`)
        // 使用默认图片
        movieNameToImageMap[movieName] = require(`../../assets/images/backgrounds/1.png`)
      }
    })
    
    console.log('🎉 电影名称映射表初始化完成!')
    console.log('📊 映射表条目数:', Object.keys(movieNameToImageMap).length)
    console.log('🔑 已映射的电影名称:', Object.keys(movieNameToImageMap).slice(0, 10).join(', '), '...')
    
    // 验证几个关键映射
    console.log('🔍 验证映射表:')
    console.log('  倩女幽魂 →', movieNameToImageMap['倩女幽魂'] ? '已映射' : '未映射')
    console.log('  黄河大侠 →', movieNameToImageMap['黄河大侠'] ? '已映射' : '未映射')
    console.log('  倩女幽魂2:人间道 →', movieNameToImageMap['倩女幽魂2:人间道'] ? '已映射' : '未映射')
  }

  // 根据数据点映射背景图片
  const handleDataPointHover = (item, index) => {
    console.log('🚀 handleDataPointHover被调用:', { item, index });
    console.log('🖼️ 图片预加载状态:', imagesLoaded);
    
    // 安全检查：确保item存在
    if (!item) {
      console.warn('⚠️ 数据项为空，无法处理悬浮事件');
      return;
    }
    
    // 如果图片还没加载完成，暂时不切换背景
    if (!imagesLoaded) {
      console.log('⏳ 图片还在加载中，暂不切换背景');
      return;
    }
    
    const movieName = item?.['电影名'] || item?.['电影'] || `数据${index + 1}`
    console.log('📝 解析电影名称:', movieName);
    
    // 方式1: 根据电影名称直接映射背景 (最优先 - 使用预加载的图片路径)
    const directImagePath = movieNameToImageMap[movieName]
    console.log('🔍 检查电影名称直接映射:', movieName, '→', directImagePath ? '已找到' : '未找到');
    if (directImagePath) {
      console.log(`🎬 电影"${movieName}" → 使用直接映射的背景图片`)
      setCurrentBackground(directImagePath)
      return
    }
    
    // 方式2: 根据全局索引映射背景
    const globalIndex = item?.['全局索引'] || item?.['globalIndex']
    console.log('🔍 检查全局索引:', globalIndex);
    if (globalIndex) {
      // 如果全局索引超出范围，使用模运算映射到1-47范围内
      const mappedIndex = globalIndex > 48 ? ((globalIndex - 1) % 47) + 1 : globalIndex
      console.log('🔍 全局索引映射:', globalIndex, '→', mappedIndex, 'backgroundImages中存在?', !!backgroundImages[mappedIndex]);
      if (backgroundImages[mappedIndex]) {
        console.log(`🎬 电影"${movieName}" (全局索引:${globalIndex}→${mappedIndex}) → 背景图片: ${mappedIndex}.png`)
        setCurrentBackground(backgroundImages[mappedIndex])
        return
      }
    }
    
    // 方式3: 根据原始数据中的序号映射背景
    const originalIndex = item?.['原始数据']?.['序号'] || item?.['序号'] || item?.['原始序号']
    console.log('🔍 检查原始序号:', originalIndex);
    if (originalIndex) {
      // 如果原始序号超出范围，使用模运算映射到1-47范围内
      const mappedIndex = originalIndex > 48 ? ((originalIndex - 1) % 47) + 1 : originalIndex
      console.log('🔍 原始序号映射:', originalIndex, '→', mappedIndex, 'backgroundImages中存在?', !!backgroundImages[mappedIndex]);
      if (backgroundImages[mappedIndex]) {
        console.log(`🎬 电影"${movieName}" (原始序号:${originalIndex}→${mappedIndex}) → 背景图片: ${mappedIndex}.png`)
        setCurrentBackground(backgroundImages[mappedIndex])
        return
      }
    }
    
    // 方式4: 根据电影ID映射背景
    const movieId = item?.['电影ID'] || item?.['ID'] || item?.['id']
    console.log('🔍 检查电影ID:', movieId);
    if (movieId && movieId <= 48 && backgroundImages[movieId]) {
      console.log(`🎬 电影"${movieName}" (ID:${movieId}) → 背景图片: ${movieId}.png`)
      setCurrentBackground(backgroundImages[movieId])
      return
    }
    
    // 方式5: 根据上映年份映射背景
    const year = item?.['上映年份'] || item?.['年份']
    console.log('🔍 检查上映年份:', year);
    if (year) {
      // 将年份映射到背景图片索引 (1966-2020 映射到 1-48)
      const yearIndex = Math.max(1, Math.min(48, year - 1965))
      if (backgroundImages[yearIndex]) {
        console.log(`🎬 电影"${movieName}" (${year}年) → 背景图片: ${yearIndex}.png (年份映射)`)
        setCurrentBackground(backgroundImages[yearIndex])
        return
      }
    }
    
    // 方式6: 根据电影名称哈希映射背景
    const nameHash = movieName.split('').reduce((hash, char) => {
      return hash + char.charCodeAt(0)
    }, 0)
    const nameIndex = (nameHash % 47) + 1 // 1-47之间
    if (backgroundImages[nameIndex]) {
      console.log(`🎬 电影"${movieName}" (名称哈希:${nameHash}) → 背景图片: ${nameIndex}.png (名称哈希映射)`)
      setCurrentBackground(backgroundImages[nameIndex])
      return
    }
    
    // 方式7: 根据数据在当前分段中的索引映射
    const imageKeys = Object.keys(backgroundImages).map(k => parseInt(k)).sort((a, b) => a - b)
    const backgroundIndex = imageKeys[index % imageKeys.length]
    if (backgroundImages[backgroundIndex]) {
      console.log(`🎬 电影"${movieName}" (索引:${index}) → 背景图片: ${backgroundIndex}.png (索引映射)`)
      setCurrentBackground(backgroundImages[backgroundIndex])
    } else {
      // 备用方案：使用第一张图片
      console.log(`🎬 电影"${movieName}" → 使用默认背景图片`)
      setCurrentBackground(backgroundImages[1] || '/assets/images/backgrounds/1.png')
    }
  }

  // 读取Excel文件
  const loadExcelData = async () => {
    console.log('📂 开始读取Excel文件...')
    
    try {
      const response = await fetch('/需求/河流图总表.xlsx')
      if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`)
      }
      
      const arrayBuffer = await response.arrayBuffer()
      const workbook = XLSX.read(arrayBuffer, { type: 'array' })
      const worksheet = workbook.Sheets[workbook.SheetNames[0]]
      const jsonData = XLSX.utils.sheet_to_json(worksheet)
      
      console.log('📊 Excel数据读取成功!')
      console.log('原始数据行数:', jsonData.length)
      console.log('数据示例:', jsonData.slice(0, 3))
      
      // 数据预处理
      const processedData = jsonData.map((item, index) => ({
        ...item,
        globalIndex: index, // 添加全局索引
        原始序号: index + 1  // 添加原始序号
      }))
      
      console.log('✅ 数据预处理完成，总计:', processedData.length, '条数据')
      
      // 更新状态
      setExcelData(processedData)
      setDataLoading(false)
      
      // 自动处理当前类别的数据
      if (processedData.length > 0) {
        console.log('🚀 自动处理当前类别数据...')
        const filteredData = processedData.filter(item => item.类别 === activeCategory)
        const sortedData = filteredData.sort((a, b) => a.上映年份 - b.上映年份)
        const segmentedData = segmentData(sortedData, segment1Percentage, segment2Percentage, segment3Percentage)
        setSegmentedData(segmentedData)
        
        console.log(`✅ ${activeCategory}类别数据自动处理完成!`)
      }
      
      return processedData
    } catch (error) {
      console.error('❌ Excel文件读取失败:', error)
      setDataError(error.message)
      setDataLoading(false)
      return []
    }
  }

  // 数据分段函数
  const segmentData = (data, seg1Percent, seg2Percent, seg3Percent) => {
    console.log('🔄 开始数据分段...')
    console.log('输入数据长度:', data.length)
    console.log('分段百分比:', { seg1: seg1Percent, seg2: seg2Percent, seg3: seg3Percent })
    
    const totalCount = data.length
    const seg1Count = Math.round(totalCount * seg1Percent)
    const seg2Count = Math.round(totalCount * seg2Percent)
    const seg3Count = totalCount - seg1Count - seg2Count // 确保总数一致
    
    console.log('计算的数据分段:', { seg1Count, seg2Count, seg3Count, total: seg1Count + seg2Count + seg3Count })
    
    const segment1 = data.slice(0, seg1Count)
    const segment2 = data.slice(seg1Count, seg1Count + seg2Count)
    const segment3 = data.slice(seg1Count + seg2Count)
    
    const result = {
      segment1: {
        data: segment1,
        count: segment1.length,
        percentage: seg1Percent
      },
      segment2: {
        data: segment2,
        count: segment2.length,
        percentage: seg2Percent
      },
      segment3: {
        data: segment3,
        count: segment3.length,
        percentage: seg3Percent
      }
    }
    
    console.log('✅ 数据分段完成:', {
      第一段: result.segment1.count,
      第二段: result.segment2.count,
      第三段: result.segment3.count,
      总计: result.segment1.count + result.segment2.count + result.segment3.count
    })
    
    return result
  }

  // 处理维度切换
  const handleCategoryChange = async (category) => {
    console.log(`🔄 切换到${category}类别...`)
    setActiveCategory(category)
    
    // 如果有数据，立即重新分段
    if (excelData.length > 0) {
      const filteredData = excelData.filter(item => item.类别 === category)
      const sortedData = filteredData.sort((a, b) => a.上映年份 - b.上映年份)
      const segmentedData = segmentData(sortedData, segment1Percentage, segment2Percentage, segment3Percentage)
      setSegmentedData(segmentedData)
      
      console.log(`✅ ${category}类别切换完成!`)
      console.log('数据分段:', {
        第一段: segmentedData.segment1.count,
        第二段: segmentedData.segment2.count,
        第三段: segmentedData.segment3.count
      })
    }
  }

  // 初始化数据处理
  useEffect(() => {
    console.log('🚀 DashboardHome组件初始化开始...')
    
    // 立即初始化映射表和背景图片
    initMovieNameMapping()
    initBackgroundImages()
    
    // 读取Excel文件并处理数据
    const initData = async () => {
      try {
        await loadExcelData()
        // loadExcelData内部已经处理了数据分段，不需要再次调用processData
        console.log('✅ 初始化完成')
      } catch (error) {
        console.error('❌ 初始化失败:', error)
        setDataError(error.message)
        setDataLoading(false)
      }
    }
    
    initData()
  }, [])

  // 监听百分比变化，重新计算数据分段
  useEffect(() => {
    if (excelData.length > 0) {
      console.log('📊 百分比发生变化，重新计算数据分段...')
      console.log('当前百分比:', { segment1: segment1Percentage, segment2: segment2Percentage, segment3: segment3Percentage })
      
      // 重新过滤和分段当前类别的数据
      const filteredData = excelData.filter(item => item.类别 === activeCategory)
      const sortedData = filteredData.sort((a, b) => a.上映年份 - b.上映年份)
      const newSegmentedData = segmentData(sortedData, segment1Percentage, segment2Percentage, segment3Percentage)
      setSegmentedData(newSegmentedData)
      
      console.log('✅ 数据分段完成:', {
        第一段: newSegmentedData.segment1.count,
        第二段: newSegmentedData.segment2.count,
        第三段: newSegmentedData.segment3.count
      })
    }
  }, [excelData, segment1Percentage, segment2Percentage, segment3Percentage, activeCategory])

  // 暴露调试函数到全局
  useEffect(() => {
    // 将测试函数暴露到全局，方便调试
    window.changePercentages = (seg1, seg2, seg3) => {
      console.log(`🔧 修改百分比: ${seg1*100}%/${seg2*100}%/${seg3*100}%`)
      setSegment1Percentage(seg1)
      setSegment2Percentage(seg2)
      setSegment3Percentage(seg3)
    }
    
    window.showMovieMapping = () => {
      console.log('🎬 当前电影名称映射表:')
      Object.entries(movieNameToImageMap).forEach(([name, imagePath]) => {
        const status = imagePath ? '✅ 已加载' : '❌ 未加载'
        console.log(`  "${name}" → ${status}`)
      })
      console.log(`📊 总计: ${Object.keys(movieNameToImageMap).length} 个电影映射`)
      console.log(`✅ 成功映射: ${Object.values(movieNameToImageMap).filter(Boolean).length} 个`)
    }
    
    console.log('🎮 测试函数已暴露:')
    console.log('  - window.changePercentages(seg1, seg2, seg3) // 修改百分比')
    console.log('  - window.showMovieMapping() // 显示电影映射表')
    console.log('📝 例如: changePercentages(0.1, 0.2, 0.7) 设置为 10%/20%/70%')
  }, [])

  return (
    <>
      <GlobalStyle />
      <DashboardContainer $backgroundUrl={currentBackground}>
        <MainContent>
          {/* 头部区域 */}
          <HeaderArea>
            {/* 左侧标题区域 */}
            <div
              style={{
                position: 'absolute',
                left: '3vw',
                top: '50%',
                transform: 'translateY(-50%)',
                display: 'flex',
                alignItems: 'center',
              }}
            >
              <img
                src="/assets/images/首页标题.png"
                alt="江湖词锋 - 图解47部经典武侠电影的全球流境"
                style={{
                  height: 'clamp(4rem, 8vh, 7rem)',
                  width: 'auto',
                  objectFit: 'contain',
                }}
              />
            </div>

            {/* 左侧装饰线条 */}
            <div
              style={{
                position: 'absolute',
                left: '16vw',
                top: '50%',
                transform: 'translateY(-50%)',
                width: '22vw',
                height: '2px',
                background: '#999999',
                opacity: 1,
              }}
            ></div>

            {/* 居中控制区域 */}
            <div
              style={{
                position: 'absolute',
                left: '50%',
                top: '50%',
                transform: 'translate(-50%, -50%)',
                display: 'flex',
                flexDirection: 'column',
                alignItems: 'center',
                gap: '1.5vh',
              }}
            >
              <span
                style={{
                  fontFamily: 'AaGuDianKeBenSong, serif',
                  fontSize: 'clamp(0.8rem, 1.1vw, 1rem)',
                  color: '#696969',
                  letterSpacing: '0.1em',
                }}
              >
                点击切换维度，解析江湖密码
              </span>

              <div
                style={{
